{
  "name": "fixhub24-platform",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "concurrently -k -n web,api \"npm:dev:web\" \"npm:dev:api\"",
    "dev:web": "vite dev",
    "dev:api": "tsx watch api/server.ts",
    "build": "vite build",
    "start": "vite preview",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "node scripts/lint.mjs",
    "test": "vitest run",
    "test:smoke": "vitest run src/test/smoke.test.ts",
    "test:sanity": "vitest run src/test/sanity.test.ts",
    "test:critical": "vitest run src/test/critical.test.ts",
    "test:regression": "vitest run src/test/regression.test.ts",
    "test:journey": "vitest run src/test/e2e-journey-api.test.ts",
    "test:playwright": "node ./node_modules/@playwright/test/cli.js test",
    "test:api": "vitest run api/test",
    "test:security": "vitest run api/test/security-quarantine-fr1.test.ts",
    "test:concurrency": "vitest run api/test/dispatch-and-race.test.ts src/test/critical.test.ts",
    "test:l10n": "vitest run src/test/fixhub24-communications.test.ts",
    "test:docs": "node --test scripts/documentation-validator.test.mjs",
    "format:check": "node ./node_modules/prettier/bin/prettier.cjs --check \"src/**/*.{ts,tsx}\" \"api/**/*.{ts,tsx}\" \"scripts/**/*.{js,mjs}\"",
    "test:all": "npm run lint && npm run test:smoke && npm run test:sanity && npm run test:critical && npm run test:regression && npm run test:journey && npm run test:security && npm test && npm run test:docs",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-toggle": "^1.1.10",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tanstack/react-query": "^5.83.0",
    "@tanstack/react-router": "^1.170.44",
    "@tanstack/react-start": "^1.169.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cors": "^2.8.6",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "lucide-react": "^1.57.0",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "react": "^19.2.0",
    "react-day-picker": "^9.13.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.62.0",
    "sonner": "^2.0.7",
    "swagger-ui-express": "^5.0.1",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.1.17",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.18.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/supertest": "^7.2.1",
    "@types/swagger-ui-express": "^4.1.8",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "jsdom": "^26.1.0",
    "supertest": "^7.3.1",
    "tailwindcss": "^4.1.17",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.9.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
