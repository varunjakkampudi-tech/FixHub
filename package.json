{
  "name": "fixhub-platform",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "concurrently -k -n web,api \"npm:dev:web\" \"npm:dev:api\"",
    "dev:web": "vite dev",
    "dev:api": "tsx watch api/server.ts",
    "build": "vite build",
    "start": "vite preview",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:api": "vitest run api/test",
    "test:docs": "node --test scripts/documentation-validator.test.mjs",
    "test:all": "npm test && npm run test:docs",
    "test:watch": "vitest"
  },
