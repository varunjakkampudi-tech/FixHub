API_HOST=127.0.0.1
API_PORT=4000
FIXHUB24_WEB_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LOG_LEVEL=info
DATABASE_URL=
DATABASE_POOL_MAX=10
AUTH_HMAC_SECRET=
RESEND_API_KEY=
RESEND_FROM_EMAIL=
TWILIO_ACCOUNT_SID=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_WHATSAPP_FROM=
TWILIO_WHATSAPP_CONTENT_SID=
# Contact-verification sends are disabled unless explicitly enabled after policy/provider review.
FIXHUB24_WHATSAPP_VERIFICATION_ENABLED=false
TWILIO_WHATSAPP_VERIFICATION_CONTENT_SID=
# Booking/offer notifications are disabled unless explicitly enabled after policy, budget and operations review.
FIXHUB24_WHATSAPP_NOTIFICATIONS_ENABLED=false
# Local development only: seed fictional demo accounts into the in-memory repository.
# Never set this in a shared, staging or production environment.
# FIXHUB24_LOCAL_DEMO_SEED=false
TWILIO_WHATSAPP_SERVICE_CONTENT_SID=
# Service template: {{1}} status, {{2}} service name, {{3}} locality; status template: {{1}} only.
TWILIO_WHATSAPP_STATUS_CONTENT_SID=
# Generate unique random secrets/keys for each environment; do not reuse AUTH_HMAC_SECRET.
WHATSAPP_CONTACT_HMAC_SECRET=
# Base64-encoded 32-byte AES key. Key rotation/recovery procedures are not yet production-ready.
WHATSAPP_CONTACT_ENCRYPTION_KEY=
